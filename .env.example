# Fill keys locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MYAI_LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
MYAI_LLM_TIMEOUT=30

MYAI_VISION_PROVIDER=deepseek
DEEPSEEK_VISION_MODEL=deepseek-flash
MYAI_VISION_TIMEOUT=120

# Optional explicit fallback (not automatic): MYAI_VISION_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-5.4-mini

# Optional private runtime-data locations
# MYAI_DATA_DIR=./private-data
# MYAI_DB_PATH=./private-data/memory.db
