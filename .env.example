# Copy this file to .env and fill in your own API key locally.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MYAI_LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
MYAI_LLM_TIMEOUT=30
MYAI_VISION_PROVIDER=deepseek
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
MYAI_VISION_TIMEOUT=120

# --- Ollama (local text model) ---
# Used only when the text provider is "ollama" (MYAI_LLM_PROVIDER=ollama).
# The values below are the built-in defaults; omit any line to keep its default.
# Note: a legacy TEXT_PROVIDER value still takes precedence over MYAI_LLM_PROVIDER.
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=60
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false
